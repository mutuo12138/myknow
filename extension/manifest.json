{
  "manifest_version": 3,
  "name": "myknow Capture",
  "version": "0.7.2",
  "description": "将你主动选择的网页、文字、图片、视频和链接保存到本机 myknow 素材库。",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://0.0.0.0/*",
        "https://0.0.0.0/*"
      ],
      "js": ["content.js"],
      "css": ["capture.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/myknow-16.png",
    "32": "icons/myknow-32.png",
    "48": "icons/myknow-48.png",
    "128": "icons/myknow-128.png"
  },
  "action": {
    "default_title": "保存到 myknow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/myknow-16.png",
      "32": "icons/myknow-32.png"
    }
  },
  "commands": {
    "capture-hovered-asset": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "保存鼠标下的图片、视频或链接"
    },
    "capture-current-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "保存当前网页"
    }
  }
}
